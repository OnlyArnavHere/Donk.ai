# Environment
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/dunkai
MONGODB_DB_NAME=

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=12

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Supervisor Agent (Python AI server)
SUPERVISOR_AGENT_URL=http://127.0.0.1:8000
SUPERVISOR_AGENT_PATH=/api/v1/supervisor
SUPERVISOR_AGENT_TOKEN=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Email (SMTP - placeholder for production)
EMAIL_FROM=noreply@dunkai.io
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Password Reset
RESET_TOKEN_EXPIRY_MIN=30
