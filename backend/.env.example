NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/dunkai
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
SUPERVISOR_AGENT_URL=http://127.0.0.1:8000
SUPERVISOR_AGENT_PATH=/api/v1/supervisor
SUPERVISOR_AGENT_TOKEN=
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
